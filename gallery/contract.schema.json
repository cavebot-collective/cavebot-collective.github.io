{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cavebot project gallery publication catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "slot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "unpublished"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "state"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "state": {
              "enum": [
                "source",
                "published"
              ]
            }
          }
        }
      ]
    },
    "hero": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "steps"
          ],
          "properties": {
            "kind": {
              "const": "concept"
            },
            "steps": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url",
            "alt",
            "fallback"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "fallback": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "summary",
        "url",
        "source",
        "publication",
        "tags",
        "hero",
        "slots"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://github.com/"
        },
        "publication": {
          "const": "listed"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hero": {
          "$ref": "#/$defs/hero"
        },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "demo",
            "specification",
            "tests",
            "ci"
          ],
          "properties": {
            "demo": {
              "$ref": "#/$defs/slot"
            },
            "specification": {
              "$ref": "#/$defs/slot"
            },
            "tests": {
              "$ref": "#/$defs/slot"
            },
            "ci": {
              "$ref": "#/$defs/slot"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "license"
          ],
          "properties": {
            "availability": {
              "enum": [
                "unpublished",
                "publicly_available"
              ]
            },
            "license": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "Verified SPDX license identifier; null when license is not verified"
            }
          }
        }
      }
    }
  }
}
