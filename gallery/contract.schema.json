{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cavebot project gallery publication catalog v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "slot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "unpublished"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "state"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "state": {
              "enum": [
                "source",
                "published"
              ]
            }
          }
        }
      ]
    },
    "hero": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "identity"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "description",
            "metrics",
            "evidence"
          ],
          "properties": {
            "kind": {
              "const": "registry_inventory"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "metrics": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "value"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "systems",
                      "triggers",
                      "recommendations",
                      "families"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project_id",
                "source_commit",
                "source_path",
                "source_git_blob_sha",
                "derived_by",
                "producer_path"
              ],
              "properties": {
                "project_id": {
                  "const": "cavebot-collective/right-tool"
                },
                "source_commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "source_path": {
                  "const": "registry/registry.json"
                },
                "source_git_blob_sha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "derived_by": {
                  "const": "scripts/export_gallery.mjs"
                },
                "producer_path": {
                  "const": "gallery/preview.v1.json"
                }
              }
            }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "summary",
        "url",
        "source",
        "publication",
        "tags",
        "hero",
        "slots"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://github.com/"
        },
        "publication": {
          "const": "listed"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hero": {
          "$ref": "#/$defs/hero"
        },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "demo",
            "specification",
            "tests",
            "ci"
          ],
          "properties": {
            "demo": {
              "$ref": "#/$defs/slot"
            },
            "specification": {
              "$ref": "#/$defs/slot"
            },
            "tests": {
              "$ref": "#/$defs/slot"
            },
            "ci": {
              "$ref": "#/$defs/slot"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "license"
          ],
          "properties": {
            "availability": {
              "enum": [
                "unpublished",
                "publicly_available"
              ]
            },
            "license": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "Verified SPDX license identifier; null when license is not verified"
            }
          }
        }
      }
    }
  }
}
